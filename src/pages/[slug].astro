---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings, MediaRepository } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import ImportedContentImage from "../components/ImportedContentImage.astro";
import PageContentBlock from "../components/PageContentBlock.astro";
import { resolveImportedMedia } from "../utils/imported-media";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { transformMigratedTables } from "../utils/tablepress";
import ClubActivitiesPanel from "../components/ClubActivitiesPanel.astro";
import TrophyTabLinks from "../components/TrophyTabLinks.astro";
import ImportedHtmlBlock from "../components/ImportedHtmlBlock.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const media = Astro.locals.emdash?.db ? new MediaRepository(Astro.locals.emdash.db) : null;
const content = await resolveImportedMedia(page.data.content ?? [], media);
const renderedContent = transformMigratedTables(content);
const hasContentHeading = Array.isArray(renderedContent) && renderedContent.some((node) => {
	if (!node || typeof node !== "object") return false;
	const block = node as { _type?: string; style?: string };
	return block._type === "block" && ["h1", "h2", "h3", "h4", "h5", "h6"].includes(block.style ?? "");
});

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const clubActivitySlugs = new Set([
	"audax-series",
	"castle-coombe-circuit",
	"insurance",
	"track-cycling",
	"weekend-rides",
	"chain-ganging",
	"youth-riding",
	"club-open-time-trials",
	"training",
	"cyclo-cross",
	"mountain-biking",
	"club-nights",
]);
const isTrophyPage = slug === "trophies-and-awards";
const isRacingPage = slug === "racing";
const isCourseMapPage = slug === "chippenham-wheelers-time-trial-course-maps";
const shortcodePageContent = (shortcode: string, componentKey: string) => Array.isArray(renderedContent)
	? renderedContent.flatMap((node) => {
		if (!node || typeof node !== "object") return [node];
		const block = node as { _type?: string; children?: Array<{ text?: string }> };
		if (block._type !== "block" || !block.children?.some((child) => child.text?.includes(shortcode))) return [node];
		return [
			{ ...block, children: block.children?.map((child) => ({ ...child, text: (child.text ?? "").split(shortcode).join("") })) },
			{ _type: "htmlBlock", _key: componentKey, html: "" },
		];
	})
	: renderedContent;
const pageContent = isTrophyPage
	? shortcodePageContent("[wptabs id=\"10032\"]", "trophy-links")
	: renderedContent;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class:list={["page-content", "site-width", { "course-map-page": isCourseMapPage, "racing-page": isRacingPage }]}>
		{clubActivitySlugs.has(slug) && <ClubActivitiesPanel />}
		{!hasContentHeading && <h1 class="page-content__title" {...page.edit.title}>{page.data.title}</h1>}
		<div class="page-content__body" {...page.edit.content}>
			<PortableText
				value={pageContent}
				components={{
					block: PageContentBlock,
					type: isTrophyPage
						? { image: ImportedContentImage, htmlBlock: TrophyTabLinks }
						: { image: ImportedContentImage, htmlBlock: ImportedHtmlBlock },
				}}
			/>
		</div>
	</article>
</Base>
