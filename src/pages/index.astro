---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PortableTextColumns from "../components/PortableTextColumns.astro";
import ImportedIframe from "../components/ImportedIframe.astro";
import HomePanels from "../components/HomePanels.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const [{ entries: posts, cacheHint }, { entry: homePage, cacheHint: homeCacheHint }] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 10 }),
	getEmDashEntry("pages", "home"),
]);
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
const firstHomeBlock = homePage?.data.content?.[0] as { _type?: string; columns?: unknown[] } | undefined;
const importedHomeContent =
	firstHomeBlock?._type === "columns" && firstHomeBlock.columns?.length === 3
		? homePage?.data.content?.slice(1)
		: homePage?.data.content;
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(homeCacheHint);
}
---

<Base title={siteTitle} description={siteTagline}>
	{homePage?.data.content?.length ? (
		<>
			<HomePanels posts={posts} />
			<div class="home-content" {...homePage.edit.content}>
			<PortableText
				value={importedHomeContent}
				components={{ type: { columns: PortableTextColumns, htmlBlock: ImportedIframe } }}
			/>
			</div>
		</>
	) : (
		<section class="home-fallback site-width">
			<HomePanels posts={posts} />
		</section>
	)}
</Base>
