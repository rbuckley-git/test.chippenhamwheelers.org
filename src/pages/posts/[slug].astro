---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	getEmDashCollection,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import PostSidebar from "../../components/PostSidebar.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { decodeHtmlEntities } from "../../utils/text";
import { transformMigratedTables } from "../../utils/tablepress";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { entries: recentPosts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 6,
});
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
const author = post.data.byline?.displayName;
---

<Base
	title={decodeHtmlEntities(seo.title) ?? decodeHtmlEntities(post.data.title) ?? "Post"}
	pageTitle={decodeHtmlEntities(seo.ogTitle)}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="post-layout site-width">
		<article class="post-article">
			<header class="post-header">
				<h1 {...post.edit.title}>{decodeHtmlEntities(post.data.title)}</h1>
				<div class="post-meta">
					{post.data.publishedAt && (
						<time datetime={post.data.publishedAt.toISOString()}>
							{post.data.publishedAt.toLocaleDateString("en-GB", {
								year: "numeric",
								month: "long",
								day: "numeric",
							})}
						</time>
					)}
					{author && <span>By {author}</span>}
					{categories.length > 0 && (
						<span class="post-categories">
							{categories.map((category, index) => (
								<span>
									{index > 0 && ", "}
									<a href={`/category/${category.slug}`}>{category.label}</a>
								</span>
							))}
						</span>
					)}
				</div>
			</header>

			{
				post.data.featured_image && (
					<figure class="post-featured-image" {...post.edit.featured_image}>
						<Image image={post.data.featured_image} />
					</figure>
				)
			}

			<div class="post-content">
				<PortableText value={transformMigratedTables(post.data.content)} />
			</div>

			{
				tags.length > 0 && (
					<footer class="post-tags" aria-label="Tags">
						<strong>Tags:</strong>
						{tags.map((tag) => <a href={`/tag/${tag.slug}`}>{tag.label}</a>)}
					</footer>
				)
			}
		</article>

		<PostSidebar posts={recentPosts} currentSlug={slug} />
	</div>
</Base>
