---
interface Props {
	node: {
		asset?: { _ref?: string; url?: string };
		alt?: string;
		caption?: string;
		alignment?: string;
		width?: number;
		height?: number;
	};
}

const { node } = Astro.props;
const asset = node?.asset;
if (!asset) return null;

const source = asset.url?.startsWith("/_emdash/api/media/file/")
	? asset.url
	: asset.url?.startsWith("http")
		? asset.url
		: `/_emdash/api/media/file/${encodeURIComponent(asset.url ?? asset._ref ?? "")}`;
const alignment = ["wide", "full", "left", "right"].includes(node.alignment ?? "")
	? node.alignment
	: "wide";
---

<figure class={`emdash-image emdash-image--align-${alignment}`}>
	<img src={source} alt={node.alt ?? ""} width={node.width} height={node.height} loading="lazy" decoding="async" />
	{node.caption && <figcaption>{node.caption}</figcaption>}
</figure>
