{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "www",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
        "workers_dev": true,
        "preview_urls": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
        "vars": {
            "EMDASH_SITE_URL": "https://dev.chippenhamwheelers.org"
        },
        "routes": [
            {
                "pattern": "dev.chippenhamwheelers.org",
                "custom_domain": true
            }
        ],
        "limits": {
            "subrequests": 10000
        },
        "kv_namespaces": [
            {
                "binding": "SESSION",
                "id": "773dbcb03dcc4dffb222caa55f22d020"
            }
        ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "www",
			"migrations_dir": "../../migrations",
			"database_id": "caace04b-c9b1-4ba1-bd97-c47048c87a70",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "www-media",
		},
	],

	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}
