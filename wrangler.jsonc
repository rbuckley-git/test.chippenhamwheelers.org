{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
        "vars": {
            "EMDASH_SITE_URL": "https://my-emdash-site.chippenhamwheelers.workers.dev"
        },
        "limits": {
            "subrequests": 10000
        },
        "kv_namespaces": [
            {
                "binding": "SESSION",
                "id": "773dbcb03dcc4dffb222caa55f22d020"
            }
        ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site",
			"migrations_dir": "../../migrations",
			"database_id": "95a061bb-7709-400f-b9ca-4f68cf60fffb",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media",
		},
	],

	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}
